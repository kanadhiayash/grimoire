{
  "schema_version": 1,
  "standard_version": "0.4.0",
  "profile": "baseline",
  "principles": {
    "read_before_editing": "required",
    "smallest_complete_change": "required",
    "evidence_before_claims": "required",
    "explicit_uncertainty": "required",
    "public_safe_output": "required",
    "detailed_at_rest_selective_in_execution": "required",
    "neutral_global_personal_overlay": "required"
  },
  "planning": {
    "material_changes_require_plan": true,
    "architecture_changes_require_decision_record": true,
    "define_verification_before_implementation": true,
    "approved_plan_revision_binding_required": true
  },
  "implementation": {
    "unrelated_refactors_forbidden": true,
    "silent_behavior_changes_forbidden": true,
    "repository_patterns_preferred": true,
    "exact_values_preserved": true,
    "minimum_correct_change_required": true
  },
  "verification": {
    "claim_success_only_after_checks": true,
    "behavior_changes_require_tests": true,
    "test_deletion_requires_justification": true,
    "lint_required_when_configured": true,
    "typecheck_required_when_configured": true,
    "build_required_when_configured": true,
    "completion_statuses": ["PASS", "PARTIAL", "BLOCKED", "NOT_VERIFIED"]
  },
  "security": {
    "secrets_forbidden": true,
    "credentials_in_examples_forbidden": true,
    "destructive_actions_require_approval": true,
    "security_gate_weakening_forbidden": true,
    "private_data_externalization_forbidden": true
  },
  "github": {
    "direct_push_to_protected_branch_forbidden": true,
    "one_mission_per_branch": true,
    "pull_request_required_for_material_changes": true,
    "changelog_required_for_release_changes": true
  },
  "ai_development": {
    "generated_code_requires_review": true,
    "invented_repository_state_forbidden": true,
    "invented_test_results_forbidden": true,
    "invented_metrics_forbidden": true,
    "instruction_conflicts_must_be_reported": true,
    "completion_report_required": true
  },
  "ai_operations": {
    "policy_path": "policies/ai-operations.json",
    "schema_path": "policies/schemas/ai-operations.schema.json",
    "policy_version": "0.2.0",
    "bounded_autonomy_required": true,
    "approval_binding_required": true,
    "single_writer_memory_required": true,
    "command_escalation_forbidden": true,
    "honest_assurance_claims_required": true
  },
  "surface_activation": {
    "policy_path": "policies/surface-activation.json",
    "schema_path": "policies/schemas/surface-activation.schema.json",
    "policy_version": "0.3.0",
    "runtime_claims_require_verification": true,
    "browser_simulation_must_be_labeled": true,
    "source_pack_integrity_required": true,
    "zeref_repository_modification_forbidden": true
  },
  "standards_orchestrator": {
    "policy_path": "policies/standards-orchestrator.json",
    "schema_path": "policies/schemas/standards-orchestrator.schema.json",
    "policy_version": "0.4.0",
    "one_canonical_repository_required": true,
    "one_project_manifest_required": true,
    "one_compiled_context_pack_required": true,
    "neutral_global_instructions_required": true,
    "personal_overlays_must_be_explicit": true,
    "automated_legal_compliance_claims_forbidden": true,
    "zeref_boundary_required": true
  },
  "exceptions": {
    "documentation_path": "docs/standards-exceptions.md",
    "undocumented_exceptions_forbidden": true
  }
}
