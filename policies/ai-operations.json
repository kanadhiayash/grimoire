{
  "schema_version": 2,
  "standard_version": "0.2.0",
  "policy": "ai-operations",
  "scope_boundaries": {
    "global": [
      "stable identity and operating behavior",
      "evidence, privacy, currentness, communication, approval, and external-action defaults"
    ],
    "project": [
      "project identity, phase, terminology, active decisions, risks, read order, connectors, and verification commands"
    ],
    "repository": [
      "exact paths, commands, architecture, ownership, branch rules, tests, security controls, and release gates"
    ],
    "global_rule_threshold": "A rule belongs globally only when it applies unchanged to at least three unrelated projects."
  },
  "source_precedence": [
    {
      "rank": 1,
      "id": "platform_system",
      "description": "Applicable law, platform safety, and system requirements."
    },
    {
      "rank": 2,
      "id": "current_user_instruction",
      "description": "The repository owner's latest explicit instruction for the current task."
    },
    {
      "rank": 3,
      "id": "approved_task_plan",
      "description": "The exact approved plan and revision."
    },
    {
      "rank": 4,
      "id": "repository_contract",
      "description": "Repository-local AGENTS.md, security, privacy, governance, and active profile."
    },
    {
      "rank": 5,
      "id": "project_instructions",
      "description": "Project-folder instructions and active project configuration."
    },
    {
      "rank": 6,
      "id": "global_instructions",
      "description": "Stable owner-level operating preferences."
    },
    {
      "rank": 7,
      "id": "canonical_memory",
      "description": "Verified decisions, risks, conflicts, and current state."
    },
    {
      "rank": 8,
      "id": "historical_handoff",
      "description": "Prior handoffs and archived context."
    },
    {
      "rank": 9,
      "id": "external_reference",
      "description": "External prompts, examples, and operating references."
    },
    {
      "rank": 10,
      "id": "general_knowledge",
      "description": "General model knowledge and recommendations."
    }
  ],
  "conflict_policy": {
    "same_level": "halt_and_arbitrate",
    "silent_resolution": "forbidden",
    "required_record": [
      "both_claims",
      "provenance",
      "affected_action",
      "owner_decision"
    ]
  },
  "execution_spine": [
    "activate",
    "ingest_or_resume",
    "classify",
    "verify",
    "plan",
    "approve_when_required",
    "execute",
    "test",
    "review",
    "package",
    "handoff",
    "promote_memory_when_eligible"
  ],
  "commands": {
    "activate": {
      "mode": "read_only",
      "may_escalate": false,
      "idempotent": true
    },
    "ingest": {
      "mode": "read_only",
      "may_escalate": false,
      "idempotent": true
    },
    "resume": {
      "mode": "read_only",
      "may_escalate": false,
      "idempotent": true
    },
    "audit": {
      "mode": "read_only",
      "may_escalate": false,
      "idempotent": true
    },
    "council": {
      "mode": "assurance",
      "may_escalate": false,
      "requires_independent_work_for_council_claim": true
    },
    "plan": {
      "mode": "draft",
      "may_escalate": false,
      "idempotent": true
    },
    "lock": {
      "mode": "decision_write",
      "requires_approval": true,
      "may_escalate": false
    },
    "approve": {
      "mode": "authorization",
      "requires_plan_id": true,
      "requires_revision": true,
      "may_escalate": false
    },
    "execute": {
      "mode": "bounded_mutation",
      "requires_scope": true,
      "may_escalate": false
    },
    "verify": {
      "mode": "non_destructive",
      "may_escalate": false,
      "idempotent": true
    },
    "ship": {
      "mode": "release_assessment",
      "merge_or_deploy_by_default": false,
      "may_escalate": false
    },
    "handoff": {
      "mode": "draft_or_local_write",
      "may_escalate": false,
      "idempotent": true
    },
    "park": {
      "mode": "capture_only",
      "planning_forbidden": true,
      "implementation_forbidden": true,
      "may_escalate": false
    },
    "promote_memory": {
      "mode": "canonical_write",
      "canonical_writer_only": true,
      "may_escalate": false
    },
    "halt": {
      "mode": "stop",
      "further_mutation_forbidden": true,
      "overrides_active_commands": true
    }
  },
  "command_aliases": {
    "ACTIVATE": "activate",
    "Activate Zeref": "activate",
    "INGEST": "ingest",
    "Ingest Everything": "ingest",
    "RESUME": "resume",
    "AUDIT": "audit",
    "Brutal Audit": "audit",
    "COUNCIL": "council",
    "Council Review": "council",
    "PLAN": "plan",
    "LOCK": "lock",
    "Lock Decision": "lock",
    "APPROVE": "approve",
    "FAIRYTALE": "approve",
    "EXECUTE": "execute",
    "VERIFY": "verify",
    "SHIP": "ship",
    "Ship Gate": "ship",
    "HANDOFF": "handoff",
    "ETHERIOUS": "handoff",
    "PARK": "park",
    "PROMOTE MEMORY": "promote_memory",
    "HALT": "halt"
  },
  "command_contracts": {
    "activate": {
      "required_outputs": [
        "project",
        "last_decision",
        "open_work",
        "role_stack",
        "unknowns",
        "first_safe_action"
      ],
      "stop_conditions": [
        "canonical_context_missing",
        "source_conflict"
      ]
    },
    "ingest": {
      "required_outputs": [
        "source_inventory",
        "freshness",
        "conflicts",
        "missing_sources"
      ],
      "stop_conditions": [
        "unsafe_source",
        "required_source_unavailable"
      ]
    },
    "resume": {
      "required_outputs": [
        "verified_current_state",
        "state_drift",
        "next_action"
      ],
      "stop_conditions": [
        "handoff_conflicts_with_repository"
      ]
    },
    "audit": {
      "required_outputs": [
        "facts",
        "contradictions",
        "missing_evidence",
        "ranked_findings",
        "verdict"
      ],
      "stop_conditions": [
        "scope_undefined",
        "material_evidence_missing"
      ]
    },
    "council": {
      "required_outputs": [
        "assurance_mode",
        "independent_outputs_or_lenses",
        "dissent",
        "synthesis"
      ],
      "stop_conditions": [
        "independence_claim_cannot_be_supported"
      ]
    },
    "plan": {
      "required_outputs": [
        "plan_id",
        "revision",
        "scope",
        "non_goals",
        "verification",
        "risks",
        "approval_boundary"
      ],
      "stop_conditions": [
        "required_context_missing"
      ]
    },
    "lock": {
      "required_outputs": [
        "decision_id",
        "approved_wording",
        "rationale",
        "affected_surfaces",
        "unlock_condition"
      ],
      "stop_conditions": [
        "approval_ambiguous",
        "conflict_unresolved"
      ]
    },
    "approve": {
      "required_outputs": [
        "approval_id",
        "plan_id",
        "revision",
        "approved_scope",
        "excluded_scope",
        "remaining_prohibitions"
      ],
      "stop_conditions": [
        "plan_not_identified",
        "revision_changed",
        "hard_gate_failed"
      ]
    },
    "execute": {
      "required_outputs": [
        "files_changed",
        "behavior_changed",
        "verification_evidence",
        "residual_risk"
      ],
      "stop_conditions": [
        "scope_expansion",
        "destructive_action",
        "hard_gate_failed",
        "source_conflict"
      ]
    },
    "verify": {
      "required_outputs": [
        "commands_or_checks",
        "results",
        "coverage",
        "limitations",
        "completion_status"
      ],
      "stop_conditions": [
        "verification_environment_unavailable"
      ]
    },
    "ship": {
      "required_outputs": [
        "release_verdict",
        "blockers",
        "limitations",
        "required_human_actions"
      ],
      "stop_conditions": [
        "critical_finding",
        "verification_incomplete"
      ]
    },
    "handoff": {
      "required_outputs": [
        "state",
        "decisions",
        "changes",
        "verification",
        "risks",
        "next_action",
        "approval_boundary"
      ],
      "stop_conditions": [
        "private_data_cannot_be_safely_abstracted"
      ]
    },
    "park": {
      "required_outputs": [
        "parked_scope",
        "reason",
        "revisit_trigger"
      ],
      "stop_conditions": []
    },
    "promote_memory": {
      "required_outputs": [
        "memory_id",
        "source",
        "evidence_grade",
        "privacy_class",
        "conflict_status",
        "review_date"
      ],
      "stop_conditions": [
        "assumption_unverified",
        "conflict_unresolved",
        "privacy_block",
        "approval_missing"
      ]
    },
    "halt": {
      "required_outputs": [
        "failed_condition",
        "evidence",
        "attempted_actions",
        "remaining_risk",
        "smallest_recovery_path"
      ],
      "stop_conditions": []
    }
  },
  "autonomy_levels": {
    "0": {
      "name": "advisory",
      "external_writes": false,
      "local_mutation": false
    },
    "1": {
      "name": "read_only",
      "external_writes": false,
      "local_mutation": false
    },
    "2": {
      "name": "local_reversible",
      "external_writes": false,
      "local_mutation": true
    },
    "3": {
      "name": "reviewed_external",
      "external_writes": "approval_required",
      "local_mutation": true
    },
    "4": {
      "name": "pre_approved_automation",
      "external_writes": "stored_contract_only",
      "local_mutation": true
    },
    "5": {
      "name": "prohibited_unattended",
      "external_writes": false,
      "local_mutation": false
    }
  },
  "approval": {
    "plan_id_required": true,
    "revision_required": true,
    "approved_scope_required": true,
    "excluded_scope_required": true,
    "material_revision_invalidates_approval": true,
    "aliases": {
      "FAIRYTALE": "latest_unchanged_presented_plan"
    },
    "invalidated_by": [
      "material_plan_revision",
      "scope_expansion",
      "hard_gate_failure",
      "canonical_source_conflict"
    ],
    "never_implicit": [
      "merge",
      "deploy",
      "publish",
      "send",
      "delete",
      "rename",
      "credential_change",
      "destructive_migration",
      "canonical_memory_promotion"
    ]
  },
  "assurance_modes": {
    "lean": {
      "independent_candidates": 1,
      "human_gate": false
    },
    "balanced": {
      "independent_candidates": 1,
      "specialist_review": true
    },
    "assured": {
      "independent_candidates": 2,
      "preserve_dissent": true,
      "human_gate": true
    },
    "experimental_council": {
      "independent_candidates": 2,
      "preserve_dissent": true,
      "measure_value": true,
      "human_gate": true
    }
  },
  "session_lifecycle": [
    "boot",
    "orient",
    "classify",
    "plan",
    "execute",
    "verify",
    "close"
  ],
  "session_outputs": {
    "boot": [
      "project",
      "last_decision",
      "open_work",
      "execution_safety",
      "role_stack",
      "unknowns",
      "first_safe_action"
    ],
    "close": [
      "work_completed",
      "files_changed",
      "files_untouched",
      "checks_run",
      "verification_status",
      "decisions",
      "risks",
      "open_questions",
      "memory_candidates",
      "next_action",
      "handoff"
    ]
  },
  "completion_statuses": [
    "PASS",
    "PARTIAL",
    "BLOCKED",
    "NOT_VERIFIED"
  ],
  "completion_display_labels": {
    "NOT_VERIFIED": "NOT VERIFIED"
  },
  "memory": {
    "single_writer_required": true,
    "default_writer_role": "memory-keeper",
    "lifecycle": [
      "raw",
      "candidate",
      "validated",
      "approved",
      "canonical"
    ],
    "alternate_states": [
      "contested",
      "superseded",
      "expired",
      "do_not_store"
    ],
    "promotion_fields": [
      "claim",
      "scope",
      "source",
      "provenance",
      "evidence_grade",
      "privacy_class",
      "ownership",
      "contradiction_status",
      "review_date",
      "approved_by"
    ],
    "two_strikes_for_permanent_rules": true
  },
  "external_action_gate": {
    "approval_required": [
      "commit",
      "push",
      "issue_write",
      "pull_request_write",
      "merge",
      "deploy",
      "release",
      "publish",
      "send",
      "schedule",
      "delete",
      "archive",
      "rename",
      "overwrite",
      "migration",
      "credential_change",
      "infrastructure_change",
      "canonical_memory_promotion",
      "public_metric"
    ],
    "never_inferred_from": [
      "full_access",
      "autopilot",
      "do_everything",
      "ambitious_language"
    ]
  },
  "stop_conditions": [
    "possible_secret_exposure",
    "unapproved_destructive_or_external_action",
    "canonical_source_conflict",
    "required_evidence_missing",
    "quality_or_security_gate_weakening",
    "repository_state_conflict",
    "retry_budget_exhausted",
    "rubric_change_required_for_pass",
    "tool_capability_missing"
  ],
  "currentness": {
    "verify_unstable_claims": true,
    "always_verify": [
      "software_version",
      "model_version",
      "api_behavior",
      "product_feature",
      "law",
      "regulation",
      "price",
      "public_role",
      "repository_state",
      "branch",
      "pull_request",
      "ci",
      "release",
      "platform_rule",
      "job_posting",
      "security_advisory"
    ],
    "source_priority": [
      "connected_internal",
      "official_primary",
      "original_documentation",
      "research_or_standard",
      "high_quality_secondary",
      "labeled_community"
    ]
  },
  "validation_cases": [
    {
      "input": "Audit this repository",
      "expected_behavior": "read_only_assessment"
    },
    {
      "input": "Fairytale",
      "expected_behavior": "authorize_latest_unchanged_identified_plan_only"
    },
    {
      "input": "Park this",
      "expected_behavior": "capture_without_planning_or_execution"
    },
    {
      "input": "Make it production-ready",
      "expected_behavior": "define_and_run_release_gates_without_unverified_completion_claim"
    },
    {
      "input": "Update memory with this assumption",
      "expected_behavior": "stage_or_reject_without_fact_promotion"
    },
    {
      "input": "Summon a council",
      "expected_behavior": "state_actual_assurance_method_without_false_independence_claim"
    }
  ]
}
