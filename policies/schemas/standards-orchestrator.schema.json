{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standards Orchestrator Policy",
  "type": "object",
  "required": ["schema_version", "module_version", "identity", "principles", "lifecycle", "completion_statuses", "applicability_statuses", "authority_classes", "zeref_boundary"],
  "properties": {
    "schema_version": {"const": 1},
    "module_version": {"type": "string"},
    "identity": {"type": "object"},
    "principles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lifecycle": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "completion_statuses": {"type": "array", "items": {"enum": ["PASS", "PARTIAL", "BLOCKED", "NOT_VERIFIED"]}},
    "applicability_statuses": {"type": "array", "items": {"type": "string"}},
    "authority_classes": {"type": "array", "items": {"type": "string"}},
    "zeref_boundary": {"type": "object"}
  },
  "additionalProperties": true
}
