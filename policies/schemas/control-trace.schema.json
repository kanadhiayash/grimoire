{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grimoire Control Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["controls", "trace_completeness"],
  "properties": {
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standard_id", "version", "state", "reason_codes", "predicate_trace", "provenance", "missing_facts", "review_required"],
        "properties": {
          "standard_id": {"type": "string", "pattern": "^GRIM-STD-[0-9]{4}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "state": {"enum": ["SELECTED", "EXCLUDED", "UNCERTAIN", "CONFLICTED"]},
          "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "predicate_trace": {"type": "object"},
          "provenance": {"type": "object"},
          "missing_facts": {"type": "array", "items": {"type": "string"}},
          "review_required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "trace_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual", "expected", "status"],
      "properties": {
        "actual": {"type": "integer", "minimum": 0},
        "expected": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL"]}
      }
    }
  }
}
