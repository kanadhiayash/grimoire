{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanadhiayash/grimoire/policies/schemas/release-evidence.schema.json",
  "title": "Grimoire release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "evidence_id",
    "source_commit",
    "created_at",
    "environment",
    "artifacts",
    "benchmarks",
    "approvals",
    "permissions",
    "signature",
    "integrity"
  ],
  "properties": {
    "schema_id": {"const": "grimoire.release.evidence.v1"},
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "pattern": "^GRM-RELEASE-[0-9a-f]{12}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "environment": {"$ref": "#/$defs/environment"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/benchmark"}
    },
    "approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/approval"}
    },
    "permissions": {"$ref": "#/$defs/permissions"},
    "signature": {"$ref": "#/$defs/signature"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "implementation", "platform", "tree_state"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "tree_state": {"enum": ["CLEAN", "DIRTY"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "commit", "suite_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_VERIFIED"]},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "suite_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "commit", "approver", "approved_at", "scope"],
      "properties": {
        "action": {"const": "release"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "approver": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "scope": {"const": "exact-commit-release"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "prohibited"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "generate-evidence",
              "rollback-dry-run",
              "verify-evidence"
            ]
          }
        },
        "prohibited": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["deploy", "publish", "release", "sign"]}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "reason"],
      "properties": {
        "status": {"enum": ["PASS", "NOT_VERIFIED"]},
        "method": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
