{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanadhiayash/grimoire/schemas/benchmarks/benchmark-suite.schema.json",
  "title": "Grimoire Benchmark Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "sources", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "hard_gate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "hard_gate": {"type": "boolean"}
        }
      }
    }
  }
}
