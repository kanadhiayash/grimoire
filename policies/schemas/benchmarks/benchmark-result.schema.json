{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanadhiayash/grimoire/schemas/benchmarks/benchmark-result.schema.json",
  "title": "Grimoire Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "commit", "environment", "source_manifest", "hard_gate_status", "verdict", "cases", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment": {"type": "object", "minProperties": 1},
    "source_manifest": {
      "type": "object",
      "required": ["commit", "sources"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sources": {"type": "array", "minItems": 1}
      }
    },
    "hard_gate_status": {"enum": ["PASS", "FAIL"]},
    "verdict": {"enum": ["PASS", "PARTIAL", "FAIL"]},
    "cases": {"type": "array", "minItems": 1},
    "metrics": {"type": "object"}
  }
}
