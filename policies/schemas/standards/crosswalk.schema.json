{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative standards crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework", "applicability", "known_external_ids", "mappings"],
  "properties": {
    "schema_version": {"const": 1},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "version_lock", "official_url", "source_license", "license_review", "review_date", "expires_on", "assurance_boundary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "version_lock": {"type": "string", "minLength": 1},
        "official_url": {"type": "string", "pattern": "^https://"},
        "source_license": {"type": "string", "minLength": 1},
        "license_review": {"type": "string", "minLength": 1},
        "review_date": {"type": "string", "format": "date"},
        "expires_on": {"type": "string", "format": "date"},
        "assurance_boundary": {"const": "mapping_only"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "platforms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ai_required": {"type": "boolean"}
      }
    },
    "known_external_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_id", "grimoire_control_ids", "rationale", "evidence_classes"],
        "properties": {
          "external_id": {"type": "string", "minLength": 1},
          "grimoire_control_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^GRIM-STD-[0-9]{4}$"}
          },
          "rationale": {"type": "string", "minLength": 1},
          "evidence_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["automated", "manual", "assistive_technology", "platform", "review", "artifact"]}
          }
        }
      }
    }
  }
}
