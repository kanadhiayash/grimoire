{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standard Record",
  "type": "object",
  "required": ["id", "title", "domain", "level", "status", "version", "purpose", "expected_outcome", "applicability", "non_applicability", "required_inputs", "unknowns_to_resolve", "required_actions", "required_decisions", "required_details", "expected_documents", "document_structure", "acceptance_criteria", "verification_method", "evidence_required", "failure_conditions", "risks_and_abuse_cases", "guards_and_limits", "exceptions", "cost_considerations", "dependencies", "related_standards", "source_provenance", "owner_and_review_cycle", "zeref_execution_behavior", "examples_and_anti_patterns"],
  "properties": {
    "id": {"type": "string", "pattern": "^STD-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "level": {"enum": ["REQUIRED", "RECOMMENDED", "OPTIONAL", "FORBIDDEN"]},
    "status": {"enum": ["DRAFT", "ACTIVE", "DEPRECATED", "SUPERSEDED"]},
    "version": {"type": "string"},
    "purpose": {"type": ["string", "array", "object"]},
    "expected_outcome": {"type": ["string", "array", "object"]},
    "applicability": {"type": ["string", "array", "object"]},
    "non_applicability": {"type": ["string", "array", "object"]},
    "required_inputs": {"type": ["string", "array", "object"]},
    "unknowns_to_resolve": {"type": ["string", "array", "object"]},
    "required_actions": {"type": ["string", "array", "object"]},
    "required_decisions": {"type": ["string", "array", "object"]},
    "required_details": {"type": ["string", "array", "object"]},
    "expected_documents": {"type": ["string", "array", "object"]},
    "document_structure": {"type": ["string", "array", "object"]},
    "acceptance_criteria": {"type": ["string", "array", "object"]},
    "verification_method": {"type": ["string", "array", "object"]},
    "evidence_required": {"type": ["string", "array", "object"]},
    "failure_conditions": {"type": ["string", "array", "object"]},
    "risks_and_abuse_cases": {"type": ["string", "array", "object"]},
    "guards_and_limits": {"type": ["string", "array", "object"]},
    "exceptions": {"type": ["string", "array", "object"]},
    "cost_considerations": {"type": ["string", "array", "object"]},
    "dependencies": {"type": ["string", "array", "object"]},
    "related_standards": {"type": ["string", "array", "object"]},
    "source_provenance": {"type": ["string", "array", "object"]},
    "owner_and_review_cycle": {"type": ["string", "array", "object"]},
    "zeref_execution_behavior": {"type": ["string", "array", "object"]},
    "examples_and_anti_patterns": {"type": ["string", "array", "object"]}
  },
  "additionalProperties": true
}
