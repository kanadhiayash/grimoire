{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanadhiayash/grimoire/policies/schemas/zeref-execution-receipt-v1.schema.json",
  "title": "Grimoire Zeref Execution Receipt v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "profile_hash",
    "pack_hash",
    "plan",
    "project",
    "roles",
    "models",
    "tools",
    "commands",
    "files_changed",
    "tests",
    "evidence",
    "approvals",
    "retries",
    "cost",
    "stop_events",
    "completion_status",
    "memory_proposals",
    "external_actions",
    "timestamp",
    "expires_at",
    "runtime",
    "integrity"
  ],
  "properties": {
    "schema_id": {"const": "grimoire.zeref.receipt.v1"},
    "schema_version": {"const": "1.0"},
    "profile_hash": {"$ref": "#/$defs/hash"},
    "pack_hash": {"$ref": "#/$defs/hash"},
    "plan": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["repository", "commit_before", "commit_after", "branch"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_before": {"$ref": "#/$defs/commit"},
        "commit_after": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["lead", "support", "quality_gate"]}
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requested", "actual"],
        "properties": {
          "requested": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "tools": {"$ref": "#/$defs/strings"},
    "commands": {"$ref": "#/$defs/strings"},
    "files_changed": {"$ref": "#/$defs/strings"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result", "evidence_id"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
          "evidence_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "control_id",
          "subject_commit",
          "command",
          "result",
          "timestamp",
          "reviewer"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "control_id": {"type": "string", "minLength": 1},
          "subject_commit": {"$ref": "#/$defs/commit"},
          "command": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
          "timestamp": {"type": "string", "format": "date-time"},
          "reviewer": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "plan_id", "revision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "plan_id": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "retries": {"type": "integer", "minimum": 0},
    "cost": {
      "type": "object",
      "required": ["amount", "currency", "ceiling_status"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "ceiling_status": {"enum": ["WITHIN_CEILING", "EXCEEDED", "NOT_VERIFIED"]}
      },
      "additionalProperties": false
    },
    "stop_events": {"type": "array", "items": {"type": "object"}},
    "completion_status": {
      "enum": ["PASS", "PARTIAL", "BLOCKED", "NOT_VERIFIED"]
    },
    "memory_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "approved", "approval_id"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "approved": {"type": "boolean"},
          "approval_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "external_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "status"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "status": {"enum": ["PERFORMED", "NOT_PERFORMED"]}
        },
        "additionalProperties": false
      }
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "required": ["harness", "zeref_layer", "capability"],
      "properties": {
        "harness": {"type": "string", "minLength": 1},
        "zeref_layer": {"type": "string", "minLength": 1},
        "capability": {
          "enum": [
            "LOCAL_HARNESS_EXECUTION",
            "PARTIAL_LOCAL_RUNTIME",
            "INERT_LOCAL_FIXTURE",
            "BROWSER_SIMULATION",
            "NOT_OBSERVABLE"
          ]
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-v1"},
        "digest": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
