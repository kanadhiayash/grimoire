{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanadhiayash/engineering-standards/policies/schema.json",
  "title": "Engineering Standards Policy",
  "type": "object",
  "required": [
    "schema_version",
    "standard_version",
    "profile",
    "principles",
    "verification",
    "security",
    "github",
    "ai_development",
    "ai_operations",
    "surface_activation",
    "exceptions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "standard_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile": {"type": "string", "minLength": 1},
    "principles": {"type": "object"},
    "planning": {"type": "object"},
    "implementation": {"type": "object"},
    "verification": {"type": "object"},
    "security": {"type": "object"},
    "github": {"type": "object"},
    "ai_development": {"type": "object"},
    "ai_operations": {
      "type": "object",
      "required": [
        "policy_path",
        "schema_path",
        "bounded_autonomy_required",
        "approval_binding_required",
        "single_writer_memory_required",
        "command_escalation_forbidden",
        "honest_assurance_claims_required"
      ]
    },
    "surface_activation": {
      "type": "object",
      "required": [
        "policy_path",
        "schema_path",
        "runtime_claims_require_verification",
        "browser_simulation_must_be_labeled",
        "source_pack_integrity_required",
        "zeref_repository_modification_forbidden"
      ]
    },
    "exceptions": {"type": "object"}
  },
  "additionalProperties": true
}
