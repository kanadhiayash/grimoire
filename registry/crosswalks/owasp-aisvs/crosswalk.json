    {"external_id": "v1.0-C1.1.1", "grimoire_control_ids": ["GRIM-STD-0027"], "rationale": "AI product engineering requires versioned model, data, retrieval, and source provenance.", "evidence_classes": ["review", "artifact"]},
    {"external_id": "v1.0-C2.1.1", "grimoire_control_ids": ["GRIM-STD-0027", "GRIM-STD-0031"], "rationale": "Context and input controls preserve bounded processing, validation, and uncertainty.", "evidence_classes": ["automated", "manual"]},
    {"external_id": "v1.0-C7.1.1", "grimoire_control_ids": ["GRIM-STD-0031"], "rationale": "Output claims remain tied to sources and unavailable evidence remains unverified.", "evidence_classes": ["automated", "manual"]},
    {"external_id": "v1.0-C9.1.1", "grimoire_control_ids": ["GRIM-STD-0033"], "rationale": "Model, tool, context, and cost routing retain explicit limits.", "evidence_classes": ["automated", "review"]},
